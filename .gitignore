# Ephemeris kernels are large (de440.bsp is ~120 MB; GitHub rejects files over 100 MB).
# They are downloaded by fetch_kernels.py and pinned by hash in kernel_store/index.json.
*.bsp
*.bsp.part

# Personal site coordinates: commit meta/config.example.json instead
meta/config.json

# Generated outputs
media/*
!media/.gitkeep
logs/*
!logs/.gitkeep
*.astro.json
*.label.txt

# Python / OS noise
__pycache__/
*.pyc
.venv/
venv/
.DS_Store
__MACOSX/
